{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-lintignore"],
  "ignoreBinaries": ["run-script"],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@capacitor-community/exif"]
    },
    "api": {
      "entry": ["src/index.ts", "src/scripts/*.ts"],
      "project": ["src/**/*.{js,ts}"],
      "ignoreDependencies": [
        "@types/mocha",
        "cross-env",
        "dotenv",
        "mocha",
        "nodemon"
      ]
    },
    "app": {
      "entry": ["src/index.tsx"],
      "project": ["src/**/*.{js,ts,tsx}"],
      "ignore": [
        "src/gui/themes/bssTheme/appBar.tsx",
        "src/gui/themes/bssTheme/noteBook.tsx",
        "src/gui/themes/bssTheme/typography.tsx",
        "src/gui/themes/default/shadows.tsx",
        "src/gui/themes/fieldmark/shadows.tsx"
      ],
      "ignoreDependencies": [
        "@bugsnag/source-maps",
        "@capacitor-mlkit/barcode-scanning",
        "@capacitor/app-launcher",
        "@capacitor/device",
        "@capacitor/status-bar",
        "@capgo/capacitor-audio-recorder",
        "@capgo/capacitor-speech-recognition",
        "@capacitor/assets",
        "node-gyp",
        "rollup-plugin-node-polyfills"
      ]
    },
    "web": {
      "entry": ["src/main.tsx"],
      "project": ["src/**/*.{js,ts,tsx}"],
      "ignoreDependencies": ["webdriverio"]
    },
    "library/forms": {
      "entry": ["lib/index.ts", "src/main.tsx"],
      "project": ["lib/**/*.{js,ts,tsx}", "src/**/*.{js,ts,tsx}"],
      "ignoreDependencies": ["buffer"]
    },
    "library/data-model": {
      "entry": ["src/index.ts", "src/databaseEngine/check.ts"],
      "project": ["src/**/*.{js,ts,tsx}"],
      "ignore": [
        "src/data_storage/dataDB/types.ts",
        "src/data_storage/directoryDB/types.ts"
      ]
    },
    "infrastructure/aws-cdk": {
      "entry": ["bin/aws-cdk-faims-infra.ts", "validateConfig.ts"],
      "project": ["bin/**/*.{js,ts}", "lib/**/*.{js,ts}", "test/**/*.{js,ts}"]
    },
    "e2e": {
      "entry": [
        "wdio*.conf.ts",
        "chrome-headless-capabilities.ts",
        "test/specs/**/*.e2e.ts"
      ],
      "project": ["**/*.ts"],
      "webdriver-io": {
        "config": ["wdio*.conf.ts"]
      },
      "ignoreDependencies": [
        "@wdio/local-runner",
        "@wdio/appium-service",
        "appium",
        "appium-uiautomator2-driver",
        "chromedriver",
        "ts-node"
      ]
    }
  }
}
